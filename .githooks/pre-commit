#!/usr/bin/env bash
# photon pre-commit hook. This repo sets its own hooks path, which replaces the global one, so the global pre-commit (the handle guard) would never run here; run it wherever it is installed.
set -euo pipefail
g="$(git config --global --get core.hooksPath || true)"; g="${g/#\~/$HOME}"
if [ -n "$g" ] && [ -x "$g/pre-commit" ]; then exec "$g/pre-commit"; fi
